# Groq Cloud API Key (Required for audio transcription fallback)
# Get yours at: https://console.groq.com/
GROQ_API_KEY=gsk_your_api_key_here

# Password de acceso a la app (Fase 3.1 del plan de mejoras).
# Se valida con comparacion constant-time; si no esta seteada, la app bloquea el acceso (fail-closed).
APP_PASSWORD=elige_una_contraseña_fuerte

# Cookies de YouTube para el bypass anti-bot en deploys cloud (Fase 1.1 del plan de mejoras).
# Como generarla: exporta cookies.txt (formato Netscape) de una sesion logueada de YouTube
# (extension "Get cookies.txt LOCALLY" o similar) y codificala en base64 de una sola linea.
# Renovar cada ~2-4 semanas o cuando reaparezcan bloqueos.
YOUTUBE_COOKIES_B64=
